type Person is record
    var age : integer
    var balance : integer
end

type Family is record
        var father : Person
        var mother : Person
        var son : Person
end

type FamilyArray is array [10] Family 

routine PersonConstructor(age : integer, balance : integer) : Person is
    var person : Person
    person.age := age
    person.balance := balance
    return person
end

routine FamilyConstructor(father : Person, mother : Person, son : Person) : Family is
    var family : Family
    family.father := father
    family.mother := mother
    family.son := son
    return family
end


routine nestedRecord(age : integer) is
    var father : Person is PersonConstructor(40, 1000000)
    var mother : Person is PersonConstructor(39, 1000)
    var son : Person is PersonConstructor(16, 100)

    var family is FamilyConstructor(father, mother, son)
