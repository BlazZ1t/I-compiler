type Person is record
    var age : integer
    var balance : integer
end

type Family is record
        var father : Person
        var mother : Person
        var son : Person
end

type FamilyArray is array [10] Family

routine nestedRecord(age : integer) is
    var families : FamilyArray

    families[0].father.age := 35
    print families[0].father.age
    for i in 1 .. age loop
        families[0].father.age := families[0].father.age + 1 
    end
    print families[0].father.age

end