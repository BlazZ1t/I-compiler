type Point is record
    var x : integer
    var y : integer
end



type Points is array [10] Point

var x : Point

routine assignY(value : integer) : integer

routine main(arg : integer) is
    type IntegerArray is array [10] integer
    var intArray : IntegerArray
end


routine assignY(value : integer) is
    type IntegerArray is array [10] integer
    var intArray : IntegerArray
    intArray[20] := 5
    print(intArray[20])
    for i in 1 .. value loop
        print intArray[i]
        intArray[i] := i
        print intArray[i]
    end
end