type Point is record
    var x : integer
    var y : integer
end


type arrayInt is array [10] integer

var x : Point

routine main(arg : integer) is
    var x : integer is 15
    var y : real is 5
    var p : Point
    var a : arrayInt
    x := 10
    p.x := 5
    a[3] := 4

    print x, p.x, a[3], a[0], p.y

end